{
  "name": "openpages",
  "version": "0.3.3-beta",
  "description": "Open source, local-first digital journal for desktop, mobile, and PWA distribution.",
  "type": "module",
  "license": "MIT",
  "private": false,
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "web:dev": "vite --host 0.0.0.0",
    "web:build": "node scripts/build-web.mjs",
    "react:dev": "vite --host 0.0.0.0 --open /index.react.html",
    "react:build": "vite build --config vite.react.config.js",
    "desktop:dev": "tauri dev",
    "desktop:build": "npm run web:build && tauri build",
    "mobile:sync": "npm run web:build && cap sync",
    "android:open": "cap open android",
    "ios:open": "cap open ios"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.1",
    "@tauri-apps/cli": "^2.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "vite": "^5.0.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "@capgo/capacitor-health": "^8.9.3",
    "page-flip": "2.0.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
